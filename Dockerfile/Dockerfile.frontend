# ==================== 前端 Dockerfile（多阶段构建）====================
# 为什么要多阶段？
#   阶段1：用 Node.js 编译 Vue 代码 → 产出纯静态文件（HTML/CSS/JS）
#   阶段2：把静态文件交给 Nginx 托管（镜像从 1GB 缩小到 30MB）

# ---------- 阶段1：构建 ----------
FROM node:20-alpine AS builder

WORKDIR /app

# 先复制依赖文件，利用缓存（依赖没变就不重新安装）
# package-lock.json 锁定每个依赖的精确版本，保证每次构建结果一致
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 复制前端源码并构建
COPY frontend/ .
RUN npm run build
# 构建完成后，产出物在 /app/dist/ 目录里

# ---------- 阶段2：Nginx 托管 ----------
FROM nginx:alpine

# 把阶段1的 dist 目录复制到 Nginx 的网页根目录
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制自定义 Nginx 配置（覆盖默认配置）
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Nginx 默认前台运行，不需要额外指定启动命令
CMD ["nginx", "-g", "daemon off;"]
